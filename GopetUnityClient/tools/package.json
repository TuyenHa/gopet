{
  "name": "gopet-unity-tools",
  "version": "1.0.0",
  "private": true,
  "description": "Công cụ hỗ trợ client Unity: sinh opcode, sinh test vector, so packet dump",
  "scripts": {
    "gen:cmd": "node gen-gopet-cmd/index.js",
    "check:cmd": "node gen-gopet-cmd/index.js --check",
    "gen:vectors": "node gen-test-vectors/index.js",
    "gen:jar-assets": "node unpack-jar-dat/index.js",
    "check:jar-assets": "node unpack-jar-dat/index.js --check",
    "test:jar-overrides": "node unpack-jar-dat/raw-png-overrides.test.js",
    "gen:jar-strings": "node extract-jar-strings/index.js",
    "gen:map-pins": "python image-gen/make-world-map-pins.py",
    "gen:attack-icon": "python image-gen/make-attack-button.py",
    "gen:mountain-tiles": "python image-gen/make-mountain-grass-tiles.py",
    "gen:path-tiles": "python image-gen/make-path-reskin-tiles.py",
    "gen:slash-fx": "python image-gen/make-slash-effect.py",
    "gen:palm": "python image-gen/make-palm-tree.py",
    "gen:lotus-pond": "python image-gen/make-lotus-pond.py",
    "gen:thatch-house": "python image-gen/make-thatch-house.py",
    "check:jar-strings": "node extract-jar-strings/index.js --check",
    "test:jar-strings": "node extract-jar-strings/index.test.js",
    "gen:all": "npm run gen:cmd && npm run gen:vectors && npm run gen:jar-assets && npm run gen:jar-strings",
    "diff": "node packet-diff/index.js"
  }
}
