# Sao chép thành .env rồi đổi giá trị.
# .env bị gitignore - không commit.
MARIADB_ROOT_PASSWORD=doi_mat_khau_nay

# ===== webadmin (profile "server" — chỉ cần trên máy chủ, xem
# docs/deployment-linux-backend.md mục "Trang quản trị webadmin") =====

# User DB riêng cho webadmin (quyền tối thiểu — docker/webadmin-grants.sql), KHÔNG dùng root.
WEBADMIN_DB_USER=gopet_admin
WEBADMIN_DB_PASSWORD=doi_mat_khau_nay
# >= 32 ký tự ngẫu nhiên, vd: openssl rand -base64 48
WEBADMIN_SESSION_SECRET=
# user_id được quyền super-admin, cách nhau dấu phẩy (1 = tài khoản admin gốc)
WEBADMIN_SUPERADMIN_USER_IDS=1

# Domain trỏ về máy chủ + danh sách IP được vào (Caddy — docker/caddy/Caddyfile).
# Test cục bộ: WEBADMIN_DOMAIN=localhost, WEBADMIN_ALLOWED_IPS="127.0.0.1 ::1".
WEBADMIN_DOMAIN=admin.example.com
WEBADMIN_ALLOWED_IPS=127.0.0.1

# Image gserver + webadmin build + push GHCR bằng GitHub Actions, máy chủ chỉ pull (mục
# 4 và 11 docs/deployment-linux-backend.md). GHCR_OWNER = tên tổ chức/user GitHub, VIẾT
# THƯỜNG (ghcr.io không chấp nhận hoa). *_TAG do deploy-service.sh cập nhật mỗi lần
# deploy (git sha 12 ký tự) — để "latest" khi mới cài đặt lần đầu.
GHCR_OWNER=tuyenha
GSERVER_TAG=latest
WEBADMIN_TAG=latest
