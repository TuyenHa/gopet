# Sao chép thành .env.local (dev) — KHÔNG commit.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=gopet_admin
DB_PASSWORD=doi_mat_khau_nay
DB_GAME=gopettae_tae2
DB_WEB=gopettae_gopet_web
DB_LOG=gp_log
# >= 32 ký tự ngẫu nhiên, ví dụ: openssl rand -base64 48
SESSION_SECRET=
# user_id được quyền super-admin, cách nhau dấu phẩy (1 = tài khoản admin)
SUPERADMIN_USER_IDS=1
# true CHỈ khi đứng sau reverse proxy do mình cấu hình (Caddy) — mới tin X-Forwarded-For
TRUSTED_PROXY=false
# Mặc định cookie secure khi NODE_ENV=production. Ép true/false nếu cần.
# COOKIE_SECURE=true
# Lệch múi giờ của DB so với UTC (phút). Mặc định 420 = +07:00 (khớp docker-compose).
# DB_TIMEZONE_OFFSET_MIN=420
